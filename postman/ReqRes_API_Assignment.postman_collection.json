    {
      "name": "Assignment 2 - Contract Validation & Exploratory Testing",
      "description": "Five exploratory/contract-validation requests. Each request automatically stores the actual HTTP status and raw response body in the selected Postman environment (R1_actual_status, R1_actual_response, etc.). Open the Postman Console or inspect environment variables after execution.",
      "item": [
        {
          "name": "R1 - Wrong data type (password as number)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/login",
            "description": "Scenario: Wrong data type. The documented AuthRequest contract defines password as a string, but this request sends a number. Record the actual status/body and assess whether the API validates the type.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"george.bluth@reqres.in\",\n  \"password\": 123456\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set(\"R1_actual_status\", String(pm.response.code));",
                  "pm.environment.set(\"R1_actual_response\", pm.response.text());",
                  "console.log(\"R1 Actual HTTP status:\", pm.response.code);",
                  "console.log(\"R1 Actual response body:\", pm.response.text());",
                  "pm.test(\"A response was received\", function () { pm.expect(pm.response.code).to.be.a(\"number\"); });"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
